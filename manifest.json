{
  "manifest_version": 3,
  "name": "Redirectory",
  "short_name": "Redirectory",
  "version": "1.0.0",
  "description": "Block distracting sites and land on your task list instead. One click to continue when you really mean it.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "src/assets/icons/icon-16.png",
    "32": "src/assets/icons/icon-32.png",
    "48": "src/assets/icons/icon-48.png",
    "128": "src/assets/icons/icon-128.png"
  },
  "action": {
    "default_title": "Redirectory",
    "default_popup": "src/pages/popup.html",
    "default_icon": {
      "16": "src/assets/icons/icon-16.png",
      "32": "src/assets/icons/icon-32.png"
    }
  },
  "options_page": "src/pages/options.html",
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "permissions": [
    "declarativeNetRequest",
    "storage",
    "alarms",
    "tabs",
    "favicon",
    "contextMenus"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/pages/blocked.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
