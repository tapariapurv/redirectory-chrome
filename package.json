{
  "name": "redirectory",
  "version": "1.0.0",
  "private": true,
  "description": "Chrome extension: block distracting sites and land on your task list instead.",
  "type": "module",
  "scripts": {
    "test": "node --test \"tests/unit/*.test.mjs\"",
    "test:e2e": "node --test --test-concurrency=1 \"tests/e2e/*.test.mjs\"",
    "test:all": "npm test && npm run test:e2e",
    "screenshots": "node tests/e2e/screenshots.mjs",
    "icons": "node tools/make-icons.mjs",
    "package": "node tools/package.mjs"
  },
  "devDependencies": {
    "playwright": "^1.50.0"
  }
}
